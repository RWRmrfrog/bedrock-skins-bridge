+//! Serializes the WIT `c-player-list` and `c-player-skin` packets, which the generated packet
+//! mapping skips because the protocol types have hand-written writers, and converts a Bedrock
+//! client's login skin to the WIT `skin` record. Plugins use these to show skins to players.
 
 use crate::pumpkin::plugin::bedrock_packets as wit;
 use crate::pumpkin::plugin::uuid::Uuid as WitUuid;
 use crate::uuid::UuidExt;
