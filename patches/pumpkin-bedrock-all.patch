diff --git a/crates/pumpkin-wasm-host-v0_1/src/bedrock_player_list.rs b/crates/pumpkin-wasm-host-v0_1/src/bedrock_player_list.rs
new file mode 100644
index 00000000..bc7b52f4
--- /dev/null
+++ b/crates/pumpkin-wasm-host-v0_1/src/bedrock_player_list.rs
@@ -0,0 +1,233 @@
+//! Serializes the WIT `c-player-list` and `c-player-skin` packets, which the generated packet
+//! mapping skips because the protocol types have hand-written writers, and converts a Bedrock
+//! client's login skin to the WIT `skin` record. Plugins use these to show skins to players.
+
+use crate::pumpkin::plugin::bedrock_packets as wit;
+use crate::pumpkin::plugin::uuid::Uuid as WitUuid;
+use crate::uuid::UuidExt;
+use base64::{Engine, engine::general_purpose::STANDARD};
+use pumpkin_protocol::bedrock::client::common::BuildPlatform;
+use pumpkin_protocol::bedrock::client::player_list::{
+    CPlayerList, PersonaPiece, PieceTintColor, PlayerListEntry, Skin,
+};
+use pumpkin_protocol::bedrock::client::player_skin::CPlayerSkin;
+use pumpkin_protocol::bedrock::server::emote::SEmote;
+use pumpkin_protocol::bedrock::server::login::ClientData;
+use pumpkin_protocol::codec::var_long::VarLong;
+use pumpkin_protocol::codec::var_uint::VarUInt;
+use pumpkin_protocol::codec::var_ulong::VarULong;
+use std::borrow::Cow;
+
+const fn build_platform(p: wit::BuildPlatform) -> BuildPlatform {
+    match p {
+        wit::BuildPlatform::Unknown => BuildPlatform::Unknown,
+        wit::BuildPlatform::Google => BuildPlatform::Google,
+        wit::BuildPlatform::Ios => BuildPlatform::Ios,
+        wit::BuildPlatform::Osx => BuildPlatform::Osx,
+        wit::BuildPlatform::Amazon => BuildPlatform::Amazon,
+        wit::BuildPlatform::GearVr => BuildPlatform::GearVr,
+        wit::BuildPlatform::Uwp => BuildPlatform::Uwp,
+        wit::BuildPlatform::Win32 => BuildPlatform::Win32,
+        wit::BuildPlatform::Dedicated => BuildPlatform::Dedicated,
+        wit::BuildPlatform::TvOs => BuildPlatform::TvOs,
+        wit::BuildPlatform::Sony => BuildPlatform::Sony,
+        wit::BuildPlatform::Nintendo => BuildPlatform::Nintendo,
+        wit::BuildPlatform::Xbox => BuildPlatform::Xbox,
+        wit::BuildPlatform::WindowsPhone => BuildPlatform::WindowsPhone,
+        wit::BuildPlatform::Linux => BuildPlatform::Linux,
+    }
+}
+
+fn skin(s: &wit::Skin) -> Skin {
+    Skin {
+        skin_id: s.skin_id.clone(),
+        play_fab_id: s.play_fab_id.clone(),
+        resource_patch: s.resource_patch.clone(),
+        image_width: s.image_width.max(0) as u32,
+        image_height: s.image_height.max(0) as u32,
+        skin_data: s.skin_data.clone(),
+        // The v0.1 WIT `skin-animation` is the login (base64) shape; animated skins are not
+        // carried through this path.
+        animations: Vec::new(),
+        cape_width: s.cape_width.max(0) as u32,
+        cape_height: s.cape_height.max(0) as u32,
+        cape_data: s.cape_data.clone(),
+        geometry_data: s.geometry_data.clone(),
+        animation_data: s.animation_data.clone(),
+        geometry_data_engine_version: s.geometry_data_engine_version.clone(),
+        cape_id: s.cape_id.clone(),
+        full_id: s.full_id.clone(),
+        arm_size: s.arm_size.clone(),
+        skin_color: s.skin_color.clone(),
+        persona_pieces: s
+            .persona_pieces
+            .iter()
+            .map(|p| PersonaPiece {
+                piece_id: p.piece_id.clone(),
+                piece_type: p.piece_type.parse().unwrap_or_default(),
+                pack_id: uuid::Uuid::parse_str(&p.pack_id).unwrap_or_default(),
+                is_default: p.is_default,
+                product_id: p.product_id.clone(),
+            })
+            .collect(),
+        piece_tint_colors: s
+            .piece_tint_colors
+            .iter()
+            .map(|t| {
+                let mut colors = [0i32; 4];
+                for (dst, src) in colors.iter_mut().zip(&t.colors) {
+                    *dst = *src;
+                }
+                PieceTintColor { piece_type: t.piece_type.clone(), colors }
+            })
+            .collect(),
+        is_premium: s.is_premium,
+        is_persona: s.is_persona,
+        persona_cape_on_classic: s.persona_cape_on_classic,
+        is_primary_user: s.is_primary_user,
+        override_appearance: s.override_appearance,
+        is_trusted: s.is_trusted,
+        profile_hash: s.profile_hash.clone(),
+    }
+}
+
+#[must_use]
+pub fn from_wit(list: &wit::CPlayerList) -> CPlayerList {
+    CPlayerList {
+        action: list.action,
+        entries: list
+            .entries
+            .iter()
+            .map(|e| {
+                let mut color = [0u8; 4];
+                for (dst, src) in color.iter_mut().zip(&e.player_color) {
+                    *dst = *src;
+                }
+                PlayerListEntry {
+                    uuid: WitUuid::from_wit(&e.uuid),
+                    entity_unique_id: VarLong(e.entity_unique_id),
+                    username: e.username.clone(),
+                    xuid: e.xuid.clone(),
+                    platform_chat_id: e.platform_chat_id.clone(),
+                    build_platform: build_platform(e.build_platform),
+                    skin: skin(&e.skin),
+                    is_teacher: e.is_teacher,
+                    is_host: e.is_host,
+                    is_sub_client: e.is_sub_client,
+                    player_color: color,
+                }
+            })
+            .collect(),
+    }
+}
+
+#[must_use]
+pub fn player_skin_from_wit(p: &wit::CPlayerSkin) -> CPlayerSkin {
+    CPlayerSkin {
+        uuid: WitUuid::from_wit(&p.uuid),
+        skin: skin(&p.skin),
+        new_skin_name: p.new_skin_name.clone(),
+        old_skin_name: p.old_skin_name.clone(),
+    }
+}
+
+fn b64(s: &str) -> Vec<u8> {
+    STANDARD.decode(s.trim()).unwrap_or_default()
+}
+
+/// Parses a login colour such as `#ffaabbcc` (ARGB) into the signed value the protocol uses.
+fn login_color(s: &str) -> i32 {
+    u32::from_str_radix(s.trim().trim_start_matches('#'), 16).unwrap_or(0) as i32
+}
+
+/// Maps a login piece type such as `persona_hair` to the numeric `persona::PieceType` value the
+/// `skin` record carries (see Mojang's protocol docs, `persona__PieceType`).
+fn persona_piece_type(name: &str) -> i32 {
+    const NAMES: [&str; 30] = [
+        "unknown", "skeleton", "body", "skin", "bottom", "feet", "dress", "top", "highpants",
+        "hands", "outerwear", "facialhair", "mouth", "eyes", "hair", "hood", "back",
+        "faceaccessory", "head", "legs", "leftleg", "rightleg", "arms", "leftarm", "rightarm",
+        "capes", "classicskin", "emote", "coco", "unsupported",
+    ];
+    let normalized: String = name
+        .trim_start_matches("persona_")
+        .chars()
+        .filter(|c| *c != '_')
+        .flat_map(char::to_lowercase)
+        .collect();
+    let normalized = if normalized == "hand" { "hands" } else { normalized.as_str() };
+    NAMES.iter().position(|n| *n == normalized).unwrap_or(0) as i32
+}
+
+/// Converts the skin a Bedrock client sent in its login data to the WIT `skin` record.
+///
+/// Images stay raw RGBA, geometry and resource patch are decoded to their JSON bytes. Animated
+/// skins are not carried over, and persona piece types are numeric like the `skin` record expects.
+#[must_use]
+pub fn login_skin(d: &ClientData) -> wit::Skin {
+    // The engine version is base64 in the login data, but accept a plain string too.
+    let engine_version = STANDARD
+        .decode(d.skin_geometry_version.trim())
+        .ok()
+        .filter(|v| !v.is_empty())
+        .unwrap_or_else(|| d.skin_geometry_version.clone().into_bytes());
+    wit::Skin {
+        skin_id: d.skin_id.clone(),
+        play_fab_id: d.play_fab_id.clone(),
+        resource_patch: b64(&d.skin_resource_patch),
+        image_width: d.skin_image_width,
+        image_height: d.skin_image_height,
+        skin_data: b64(&d.skin_data),
+        animations: Vec::new(),
+        cape_width: d.cape_image_width,
+        cape_height: d.cape_image_height,
+        cape_data: b64(&d.cape_data),
+        geometry_data: b64(&d.skin_geometry),
+        animation_data: b64(&d.skin_animation_data),
+        geometry_data_engine_version: engine_version,
+        cape_id: d.cape_id.clone(),
+        full_id: format!("{}{}", d.skin_id, d.cape_id),
+        arm_size: d.arm_size.clone(),
+        skin_color: d.skin_colour.clone(),
+        persona_pieces: d
+            .persona_pieces
+            .iter()
+            .map(|p| wit::PersonaPiece {
+                is_default: p.is_default,
+                pack_id: p.pack_id.clone(),
+                piece_id: p.piece_id.clone(),
+                piece_type: persona_piece_type(&p.piece_type).to_string(),
+                product_id: p.product_id.clone(),
+            })
+            .collect(),
+        piece_tint_colors: d
+            .piece_tint_colours
+            .iter()
+            .map(|t| wit::PieceTintColor {
+                piece_type: t.piece_type.clone(),
+                colors: t.colours.iter().map(|c| login_color(c)).collect(),
+            })
+            .collect(),
+        is_premium: d.premium_skin,
+        is_persona: d.persona_skin,
+        persona_cape_on_classic: d.cape_on_classic_skin,
+        is_primary_user: true,
+        override_appearance: d.override_skin,
+        is_trusted: d.trusted_skin,
+        profile_hash: String::new(),
+    }
+}
+
+/// The clientbound emote packet has the same layout as the serverbound one, so the protocol's
+/// `SEmote` is reused to write it.
+#[must_use]
+pub fn emote_from_wit(e: &wit::CEmote) -> SEmote<'_> {
+    SEmote {
+        actor_runtime_id: VarULong(e.actor_runtime_id.max(0) as u64),
+        emote_id: Cow::Borrowed(e.emote_id.as_str()),
+        emote_length_ticks: VarUInt(e.emote_length_ticks.max(0) as u32),
+        xuid: Cow::Borrowed(e.xuid.as_str()),
+        platform_id: Cow::Borrowed(e.platform_id.as_str()),
+        flags: e.flags,
+    }
+}
