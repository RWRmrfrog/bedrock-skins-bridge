@@ -0,0 +1,24 @@
+use pumpkin_macros::packet;
+use uuid::Uuid;
+
+use crate::serial::PacketWrite;
+
+use super::player_list::Skin;
+
+/// Changes the skin of a player the client can already see.
+///
+/// Clients send this when their player changes skin (serverbound id 93) and servers broadcast it
+/// to the other clients. Mojang's protocol docs describe it as the packet third-party servers use
+/// to send custom geometry. A `PlayerList` entry only supplies the skin when a player is spawned.
+#[derive(PacketWrite)]
+#[packet(93)]
+pub struct CPlayerSkin {
+    /// UUID of the player whose skin changes.
+    pub uuid: Uuid,
+    /// The new skin.
+    pub skin: Skin,
+    /// Localized name of the new skin.
+    pub new_skin_name: String,
+    /// Localized name of the previous skin.
+    pub old_skin_name: String,
+}
