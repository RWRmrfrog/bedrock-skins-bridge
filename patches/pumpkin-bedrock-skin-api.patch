+use pumpkin_protocol::bedrock::server::login::ClientData;
 use pumpkin_protocol::codec::var_long::VarLong;
 
 const fn build_platform(p: wit::BuildPlatform) -> BuildPlatform {
@@ -112,3 +116,100 @@ pub fn from_wit(list: &wit::CPlayerList) -> CPlayerList {
             .collect(),
     }
 }
+
+#[must_use]
+pub fn player_skin_from_wit(p: &wit::CPlayerSkin) -> CPlayerSkin {
+    CPlayerSkin {
+        uuid: WitUuid::from_wit(&p.uuid),
+        skin: skin(&p.skin),
+        new_skin_name: p.new_skin_name.clone(),
+        old_skin_name: p.old_skin_name.clone(),
+    }
+}
+
+fn b64(s: &str) -> Vec<u8> {
+    STANDARD.decode(s.trim()).unwrap_or_default()
+}
+
+/// Parses a login colour such as `#ffaabbcc` (ARGB) into the signed value the protocol uses.
+fn login_color(s: &str) -> i32 {
+    u32::from_str_radix(s.trim().trim_start_matches('#'), 16).unwrap_or(0) as i32
+}
+
+/// Maps a login piece type such as `persona_hair` to the numeric `persona::PieceType` value the
+/// `skin` record carries (see Mojang's protocol docs, `persona__PieceType`).
+fn persona_piece_type(name: &str) -> i32 {
+    const NAMES: [&str; 30] = [
+        "unknown", "skeleton", "body", "skin", "bottom", "feet", "dress", "top", "highpants",
+        "hands", "outerwear", "facialhair", "mouth", "eyes", "hair", "hood", "back",
+        "faceaccessory", "head", "legs", "leftleg", "rightleg", "arms", "leftarm", "rightarm",
+        "capes", "classicskin", "emote", "coco", "unsupported",
+    ];
+    let normalized: String = name
+        .trim_start_matches("persona_")
+        .chars()
+        .filter(|c| *c != '_')
+        .flat_map(char::to_lowercase)
+        .collect();
+    let normalized = if normalized == "hand" { "hands" } else { normalized.as_str() };
+    NAMES.iter().position(|n| *n == normalized).unwrap_or(0) as i32
+}
+
+/// Converts the skin a Bedrock client sent in its login data to the WIT `skin` record.
+///
+/// Images stay raw RGBA, geometry and resource patch are decoded to their JSON bytes. Animated
+/// skins are not carried over, and persona piece types are numeric like the `skin` record expects.
+#[must_use]
+pub fn login_skin(d: &ClientData) -> wit::Skin {
+    // The engine version is base64 in the login data, but accept a plain string too.
+    let engine_version = STANDARD
+        .decode(d.skin_geometry_version.trim())
+        .ok()
+        .filter(|v| !v.is_empty())
+        .unwrap_or_else(|| d.skin_geometry_version.clone().into_bytes());
+    wit::Skin {
+        skin_id: d.skin_id.clone(),
+        play_fab_id: d.play_fab_id.clone(),
+        resource_patch: b64(&d.skin_resource_patch),
+        image_width: d.skin_image_width,
+        image_height: d.skin_image_height,
+        skin_data: b64(&d.skin_data),
+        animations: Vec::new(),
+        cape_width: d.cape_image_width,
+        cape_height: d.cape_image_height,
+        cape_data: b64(&d.cape_data),
+        geometry_data: b64(&d.skin_geometry),
+        animation_data: b64(&d.skin_animation_data),
+        geometry_data_engine_version: engine_version,
+        cape_id: d.cape_id.clone(),
+        full_id: format!("{}{}", d.skin_id, d.cape_id),
+        arm_size: d.arm_size.clone(),
+        skin_color: d.skin_colour.clone(),
+        persona_pieces: d
+            .persona_pieces
+            .iter()
+            .map(|p| wit::PersonaPiece {
+                is_default: p.is_default,
+                pack_id: p.pack_id.clone(),
+                piece_id: p.piece_id.clone(),
+                piece_type: persona_piece_type(&p.piece_type).to_string(),
+                product_id: p.product_id.clone(),
+            })
+            .collect(),
+        piece_tint_colors: d
+            .piece_tint_colours
+            .iter()
+            .map(|t| wit::PieceTintColor {
+                piece_type: t.piece_type.clone(),
+                colors: t.colours.iter().map(|c| login_color(c)).collect(),
+            })
+            .collect(),
+        is_premium: d.premium_skin,
+        is_persona: d.persona_skin,
+        persona_cape_on_classic: d.cape_on_classic_skin,
+        is_primary_user: true,
+        override_appearance: d.override_skin,
+        is_trusted: d.trusted_skin,
+        profile_hash: String::new(),
+    }
+}
